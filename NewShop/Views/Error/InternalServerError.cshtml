@model NewShop.Models.ErrorViewModel

@{
    ViewBag.Title = "Internal Server Error";
}

<div class="container" style="margin-top:50px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="panel panel-danger">

                <div class="panel-heading text-center">
                    <h2>
                        <span class="glyphicon glyphicon-warning-sign"></span>
                        Internal Server Error
                    </h2>
                </div>

                <div class="panel-body text-center">

                    @*<h1 style="font-size:72px;margin-bottom:20px;">
                        500
                    </h1>*@

                    <h3>
                        An unexpected error occurred.
                    </h3>

                    <p class="text-muted" style="margin-top:20px;">
                        The system encountered an unexpected error while processing your request.
                        Please contact the system administrator if the problem persists.
                    </p>

                    <hr />

                    <div class="alert alert-info text-left">

                        <strong>Reference ID :</strong>

                        @Model.ErrorId

                    </div>

                    @if (Model.IsAdmin) {
                        <div class="panel panel-default text-left">

                            <div class="panel-heading">

                                <strong>
                                    Error Detail (Administrator Only)
                                </strong>

                            </div>

                            <div class="panel-body">

                                <p>

                                    <strong>Error Type :</strong>

                                    @Model.ErrorType

                                </p>

                                <p>

                                    <strong>Message :</strong>

                                    @Model.Message

                                </p>

                                <hr />

                                <pre style="
max-height:350px;
overflow:auto;
white-space:pre-wrap;
word-break:break-word;">@Model.StackTrace</pre>

                            </div>

                        </div>
                    }

                    <div style="margin-top:20px;">

                        <a href="@Url.Action("Account","Login")"
                           class="btn btn-primary btn-lg">

                            <span class="glyphicon glyphicon-home"></span>

                            Back to Dashboard

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>