@{
    ViewBag.Title = "_CustomerRegister";
}
<style>
    .cursor-pointer {
        cursor: pointer;
    }

    input[type=checkbox] {
        transform: scale(2.0);
    }

    .list-group {
        max-height: 520px;
        margin-bottom: 10px;
        overflow: scroll;
        -webkit-overflow-scrolling: touch;
        font-size: 14px;
    }

    @@media screen and (max-width: 576px) {
        .textCut {
            /*display: inline-block;*/
            /*width: 350px;*/
            white-space: nowrap;
            overflow: hidden !important;
            text-overflow: ellipsis;
        }
    }

    .list-group-item:hover {
        background-color: #f5f5f5;
    }
</style>
<div class="card-footer p-2">
    <div class="row" style="margin-top: -10px;">
        <div class="col-12">
            <div class="card mb-12 mt-2">
                <div class="card-header text-black font-weight-bold" style="background-color: #f9dfbf;">
                    <div class="row">
                        <div class="col-xs-10 col-sm-10 col-md-10 text-left">
                            <sapn> @ViewBag.textHeader </sapn>  <span class="label label-warning"> <span id="countCustomer"> @ViewBag.countCustomer </span>/ <span id="countCustomerReg"> @ViewBag.countCustomerReg </span> </span>
                        </div>
                        <div class="col-xs-2 col-sm-2 col-md-2 text-right">
                            <button class="btn btn-md btn-success" onclick="saveCustomerRegister();" style="margin: -5px; border: solid 2px #1b9f1b;"> <i class="fa fa-save"> </i> Save </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush w-100 align-items-stretch">
                        @{
                            int rowList = 1;
                            foreach (var rowData in ViewBag.customerRegisterList)
                            {
                                var checkboxChecked = "";
                                var checkboxDisable = "";
                                if (!string.IsNullOrEmpty(@rowData.FlagReg))
                                {
                                    checkboxChecked = "checked";
                                }
                                if (!string.IsNullOrEmpty(@rowData.FlagApprove))
                                {
                                    checkboxDisable = "disabled";
                                }
                                <li id="list-code-@rowData.Cuscode" class="list-group-item cursor-pointer d-flex justify-content-between align-items-center py-1 pl-3" style="white-space: nowrap;">
                                    <span class="align-middle textCut" style="padding: 7px;">
                                        <input type="checkbox" name="selectPromotion" id="selectPromotion" class="cursor-pointer" value="@rowData.Cuscode" data-cuscode="@rowData.Cuscode" @checkboxChecked @checkboxDisable />
                                        <span class="pl-1"> @rowData.Cuscode (@rowData.Cusname) </span>
                                    </span>
                                    <span class="list-group-item-heading justify-content-between align-items-center">
                                        @if (@rowData.FlagApprove == "Y")
                                        {
                                            <span class="label label-danger pull-right">รอ Approve</span>
                                        }
                                    </span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script defer>
