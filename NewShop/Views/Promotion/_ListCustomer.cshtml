                title: 'ต้องการบันทึกใช่หรือไม่',
                html: 'เลือกร้านค้าจำนวน [ ' + countCustomer + " / " + countSelect  +' ] ร้านค้า',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#00a65a',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fa fa-check"></i> ใช่',
                cancelButtonText: '<i class="fa fa-times"></i> ไม่',
                allowOutsideClick: false,
                focusConfirm: false,
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        type: 'POST',
                        cache: false,
                        url: '@Url.Action("SaveCustomerRegister", "Promotion")',
                        data: JSON.stringify({
                            user: '@Session["UserID"]',
                            slmCode: slmCode,
                            promotionCode: promotionCode,
                            promotionSeq: promotionSeq,
                            cusCode: request
                        }),
                        contentType: "application/json; charset=utf-8",
                        enctype: 'multipart/form-data',
                        beforeSend: function () {
                            LoadingShow();
                        },
                        success: function (result) {
                            if (result.status = "Y") {
                                Swal.fire({
                                    title: 'บันทึกเรียบร้อย',
                                    //html: 'บันทึกเรียบร้อย',
                                    icon: 'success',
                                    confirmButtonColor: '#3085d6',
                                    confirmButtonText: 'ปิด',
                                    allowOutsideClick: false,
                                    focusConfirm: false,
                                    timer: 6000,
                                    timerProgressBar: true,
                                    onClose: () => {
                                        $(window).unbind('beforeunload');
                                        LoadingHide();
                                        $('form[id="forecastPmForm"]').submit();
                                    }
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error not saved',
                                    html: result.message,
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'ปิด',
                                    allowOutsideClick: false,
                                    focusConfirm: false,
                                });
                            }
                        },
                        complete: function (res) {
                            LoadingHide();
                        }
                    }).fail(function (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error not saved',
                            html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>SaveCustomerRegister<br><br>',
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'ปิด',
                            allowOutsideClick: false,
                            focusConfirm: false,
                        });
                    });
                }
            });
        //}
