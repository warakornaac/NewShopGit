    $("input[name='selectPromotion']").click(function () {
        var countCustomerReg = 0;
        $("input[name='selectPromotion']:checked").each(function () {
            var cuscode = $(this).data("cuscode");
            if (cuscode != null) {
                countCustomerReg++;
            }
        });
        $("#countCustomerReg").text(countCustomerReg);
    });
    //btn save
    saveCustomerRegister = async () => {
        var request = [];
        var slmCode = $("#slmCode option:selected").val();
        var promotionCode = $("input[name=selectPromotionSub]:checked").data('code');
        var promotionSeq = $("input[name=selectPromotionSub]:checked").data('seq');
        var countCustomer = $("#countCustomer").text();
        var countSelect = 0;
        $("input[name='selectPromotion']:checked").each(function () {
            var cuscode = $(this).data("cuscode");
            if (cuscode != null) {
                ++countSelect;
                request.push(cuscode);
               // console.log("request = " + request);
            }
        });
        Swal.fire({
            title: 'ต้องการบันทึกใช่หรือไม่',
            html: 'เลือกร้านค้าจำนวน [ ' + countSelect  +' ] ร้านค้า',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00a65a',
            cancelButtonColor: '#d33',
            confirmButtonText: '<i class="fa fa-check"></i> ใช่',
            cancelButtonText: '<i class="fa fa-times"></i> ไม่',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then((result) => {
            if (result.value) {
                $.ajax({
                    type: 'POST',
                    cache: false,
                    url: '@Url.Action("SaveCustomerRegister", "Promotion")',
                    data: JSON.stringify({
                        user: '@Session["UserID"]',
                        slmCode: slmCode,
                        promotionCode: promotionCode,
                        promotionSeq: promotionSeq,
                        cusCode: request
                    }),
                    contentType: "application/json; charset=utf-8",
                    enctype: 'multipart/form-data',
                    beforeSend: function () {
                        LoadingShow();
                    },
                    success: function (result) {
                        if (result.status == "Y") {
                            //refresh list customer again
                            var promotionCode = $("#promotionCode option:selected").val();
                            searchPromotionReg(promotionCode);
                            setTimeout(() => {
                                //console.log(promotionSeq);
                                $("input[name=selectPromotionSub][value=" + promotionSeq + "]").attr("checked", true).trigger("click");
                            }, "1200");
                            //$("input[name=selectPromotionSub]:checked").attr("checked", true).trigger("click");

                            Swal.fire({
                                title: 'บันทึกเรียบร้อย',
                                //html: 'บันทึกเรียบร้อย',
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                onClose: () => {
                                    LoadingHide();
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error not saved',
                                html: result.status,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
                    },
                    complete: function (res) {
                        LoadingHide();
                    }
                }).fail(function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error not saved',
                        html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>saveCustomerRegister<br><br>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                });
            }
        });
    }
</script>