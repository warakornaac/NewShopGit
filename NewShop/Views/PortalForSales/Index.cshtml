    @*FORGET PASSWORD*@
    <div class="modal fade modal-forget" id="modalForgetPassword" tabindex="-1" role="dialog" aria-labelledby="ModalForgetPassword" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ลืมรหัสผ่าน</h5>
