                            <div class="wrap">
                                @*<div class="img" style="background-image: url(../../images/bg-1.jpg);"></div>*@
                                <div class="login-wrap p-4 p-md-5">
                                    <div class="d-flex text-center">
                                        <div class="w-100">
                                            <h4 class="font-bold" style="color: #000000;">เลือกลูกค้า</h4>
                                        </div>

                                    </div>
                                    @*<form class="signin-form" action="#" method="post">*@
                                    <div class="form-group">
                                        <label class="control-label" for="sale-man-txt" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px;">SALEMAN</label>
                                        <input type="text" class="form-control" id="sale-man-txt" name="sale-man" placeholder="SaleMan" readonly>
                                        <label class="form-control-placeholder" for="username"></label>
                                        @*<p class="warning-red" id="wronguser" hidden>Username ไม่ถูกต้อง</p>*@
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label" for="username" style="color: #2d6eff; font-weight: bold; font-size: 13px; margin-bottom: 2px; ">CUSTOMER</label>
                                        <div class="input-group mb-1" id="show_hide_password">
                                            @*<input type="password" class="form-control" id="inputPassword" name="password" placeholder="Password" required>*@
                                            @*<div class="input-group-append ">
                                                    <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                                </div>*@
                                            <select class="form-control selectpicker" data-container="body" data-live-search="true" title="เลือกลูกค้า" data-hide-disabled="true" id="selcus">
                                                <option value="110Z0001O" data-name="Tru Automotive (Testing)">
                                                    110Z0001O/Tru Automotive (Testing)
                                                </option>
                                            </select>
                                        </div>
                                    </div>
