@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Access Denied";
}

<div class="container" style="margin-top:50px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="panel panel-warning">

                <div class="panel-heading text-center">
                    <h2>
                        <span class="glyphicon glyphicon-lock"></span>
                        Access Denied
                    </h2>
                </div>

                <div class="panel-body text-center">

                    @*<h1 style="font-size:72px;margin-bottom:20px;">
                        403
                    </h1>*@

                    <h3>
                        You do not have permission to access this page.
                    </h3>

                    <p class="text-muted" style="margin-top:20px;">
                        Your account does not have the required permission to perform this action.
                        Please contact your system administrator if you believe this is incorrect.
                    </p>

                    <hr />

                    <div style="margin-top:20px;">
                        <a href="@Url.Action("Account","Login")"
                           class="btn btn-primary btn-lg">

                            <span class="glyphicon glyphicon-home"></span>
                            Back to MobileOrder
                        </a>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>