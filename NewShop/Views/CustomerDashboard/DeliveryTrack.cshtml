        function GetOrderDetail(ORD_DocNo,Status) {
            $('#DetailModalCenter').modal('show');
            $('#orderno').text(ORD_DocNo);
            $('#statusord').text(Status)
            var CUSCOD = cuscod;
            $.ajax({
                url: '@Url.Action("GetDeliveryDetail", "CustomerDashboard")',
                data: {
                    ORD_DocNo: ORD_DocNo
                },
                type: "POST",
                dataType: "JSON",
                success: function (data) {
                    $('#tblOrderDetail tbody:last-child').html("");
                    if (data.message == "Y") {
                        if (data.Getdata.length != 0) {
                            var SubmithtmlPage = '';
                            var dateOrder = '';
                            $('#orderno').text(ORD_DocNo);
                            for (var i = 0; i < data.Getdata.length; i++) {
                                dateOrder = data.Getdata[i].VORDDAT;
                                SubmithtmlPage += '<tr>';
                                SubmithtmlPage += '<td align="left">' + data.Getdata[i].VSTKCOD + '</td>';
                                SubmithtmlPage += '<td class="text-truncate" align="left" style="max-width: 100px;">' + data.Getdata[i].VSTKDES+ '</td>';
                                SubmithtmlPage += '<td align="center">' + data.Getdata[i].AmtQty + '</td>';
                                SubmithtmlPage += '</tr>';
                            }
                            $('#orddate').text(dateOrder.replace(/\//g,"-"));
                            $('#tblOrderDetail tbody:last-child').append(SubmithtmlPage);
                        }
                    }
                    else {
                        console.log(data.message);
                    }
                }

            });
        }
