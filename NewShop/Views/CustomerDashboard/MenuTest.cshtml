        function getDeliveryTrackAmt() {
            $.ajax({
                 url: '@Url.Action("GetAlertDeliveryTracking", "CustomerDashboard")',
                 data: {
                     CUSCOD: cuscod
                 },
                 type: "POST",
                dataType: "JSON",
                success: function (res) {
                    if (res.message == "Y") {
                        var alert_accept = 0;
                        var alert_packing = 0;
                        var alert_delivery = 0;
                        var alert_arrive = 0;
                        var total_delivery = 0;
                        if (res.Getdata.length > 0) {
                            alert_accept = res.Getdata[0].Order;
                            alert_packing = res.Getdata[0].Pack;
                            alert_delivery = res.Getdata[0].Deliver;
                            alert_arrive = res.Getdata[0].Arrive;
                            total_delivery = alert_accept + alert_packing + alert_delivery + alert_arrive;
                            $('#total_deliverytrack').text(commaSeparateNumber(total_delivery));

                        }
                    }
                    else {
                        console.log(res.message);
                    }
                }
            });
        }
        function getBackorderAmt() {
            var typeS = 0;
            var backorder = 0;
            var total = 0;
            $.ajax({
                 url: '@Url.Action("getbackorder_S_notify", "CustomerDashboard")',
                 data: {
                     CUSCOD: cuscod
                 },
                 type: "POST",
                dataType: "JSON",
                success: function (res) {
                    if (res.message == "Y") {
                        if (res.backorder.length > 0) {
                            typeS = res.backorder.length;
                        }
                    }
                    else {
                        console.log("Error S : " + res.message);
                    }
                }
            });
            $.ajax({
                 url: '@Url.Action("getbackorder_notify", "CustomerDashboard")',
                 data: {
                     CUSCOD: cuscod
                 },
                 type: "POST",
                dataType: "JSON",
                success: function (res) {
                    if (res.message == "Y") {
                        if (res.backorder.length > 0) {
                            backorder = res.backorder.length;
                            total = typeS + backorder;
                            console.log("TypeS is :" + typeS);
                            console.log("BO is " + backorder);
                            $('#backorder-amt').text(commaSeparateNumber(total));
                        }
                    }
                    else {
                        console.log("Error S : " + res.message);
                    }
                }
            });
        }
        function getWarrantyAmt() {
            var total = 0;
            $.ajax({
                 url: '@Url.Action("GetdataWarrantyClaim_Cus_count", "DataCenter")',
                 data: {
                     strcustome: cuscod
                 },
                 type: "POST",
                dataType: "JSON",
                success: function (data) {
                    if (data.length > 0) {

                        var waiting = data[0].A != "" ? Number(data[0].A) :0;
                        var inprogress = data[0].B != "" ? Number(data[0].B) : 0;
                        var pending = data[0].C != "" ? Number(data[0].C) : 0;
                        total = waiting + inprogress + pending;
                        $('#warranty-amt').text(commaSeparateNumber(total));
                    }
                }
            });
        }

