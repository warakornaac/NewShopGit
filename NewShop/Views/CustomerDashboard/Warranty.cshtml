    <script type="text/javascript">
        //var cuscod = '@Request.RequestContext.HttpContext.Session["CUSCOD"]';
         var cuscod = '111B0005';
        var user = '@Request.RequestContext.HttpContext.Session["UserID"]';
        var usertype = '@Request.RequestContext.HttpContext.Session["UserType"]';
        $(document).ready(function () {
            $('#loader').show();
            setTimeout(function () {
                $('#loader').hide();
                $('#content').removeClass('d-none').addClass('d-flex');
                $('.footer').removeAttr('hidden');
            }, 2000);
        });
        if (cuscod.trim() != '') {
            getWarranty(cuscod);
        }
        function toggleRowWaranty(row,col) {
            var text = $('#show-'+col+'-icon');
            if (text.text() === '+') {
                text.text("-");
            } else {
                text.text("+");
            }
            var targetId = row.getAttribute('data-bs-target');
            var targetElement = document.getElementById(targetId.substring(1));
            $(targetElement).collapse('toggle');
        }
        function getWarranty(cus) {
            $.ajax({
                url: '@Url.Action("GetdataWarrantyClaim_Cus_count", "DataCenter")',
                data: {
                    strcustome: cus
                },
                type: "POST",
                dataType: "JSON",
                success: function (data) {
                    if (data.length > 0) {
                        var total = 0;
                        for (var i = 0; i < data.length; i++) {
                            console.log("has data :" + data[i].C);
                            var waiting = data[i].A != "" ? data[i].A : "0";
                            var inprogress = data[i].B != "" ? data[i].B : "0";
                            var pending = data[i].C != "" ? data[i].C : "0";
                            $('#waiting-warranty').text(waiting);
                            $('#inprogress-warranty').text(inprogress);
                            $('#pending-warranty').text(pending);
                            total = Number(waiting) + Number(inprogress) + Number(pending);
                        }

                    }
                }
            });
        }

        function getWarrantyWaiting() {
             $.ajax({
                 url: '@Url.Action("GetdataWarrantyClaim_Cus", "DataCenter")',
                 data: {
                     strcustome: cuscod,
                     tap: 'a'
                 },
                 type: "POST",
                 dataType: "JSON",
                 beforeSend: function () {
                     $('#waiting-detail tbody').html("");
