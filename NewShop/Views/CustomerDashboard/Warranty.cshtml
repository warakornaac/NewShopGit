                     SubmithtmlPage += '<tr>';
                     SubmithtmlPage += '<td colspan="6" align="center"> <i class="fa fa-circle-o-notch fa-spin"></i> Loading...</td>';
                     SubmithtmlPage += '</tr>';
                     $("#waiting-detail").append(SubmithtmlPage);
                 },
                 success: function (data) {
                     $('#waiting-detail tbody').html("");
                     var SubmithtmlPage = "";
                     if (data.length > 0) {
                         for (var i = 0; i < data.length; i++) {

                             SubmithtmlPage += '<tr>';
