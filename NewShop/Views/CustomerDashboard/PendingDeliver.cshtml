        function jssor_1_slider_init() {

            var jssor_1_options = {
                $AutoPlay: 0,
                $AutoPlaySteps: 5,
                $SlideDuration: 260,
                $SlideWidth: 200,
                $SlideSpacing: 3,
                $ArrowNavigatorOptions: {
                    $Class: $JssorArrowNavigator$,
                    $Steps: 1
                },
                $BulletNavigatorOptions: {
                    $Class: $JssorBulletNavigator$,
                    $SpacingX: 16,
                    $SpacingY: 16
                }
            };

            var jssor_1_slider = new $JssorSlider$("jssor_1", jssor_1_options);

            /*#region responsive code begin*/

            var MAX_WIDTH = 758;

            function ScaleSlider() {

                var containerElement = jssor_1_slider.$Elmt.parentNode;
                var containerWidth = containerElement.clientWidth;

                if (containerWidth) {

                    var expectedWidth = Math.min(MAX_WIDTH || containerWidth, containerWidth);

                    jssor_1_slider.$ScaleWidth(expectedWidth);
                }
                else {
                    window.setTimeout(ScaleSlider, 30);
                }
            }

            ScaleSlider();

            $Jssor$.$AddEvent(window, "load", ScaleSlider);
            $Jssor$.$AddEvent(window, "resize", ScaleSlider);
            $Jssor$.$AddEvent(window, "orientationchange", ScaleSlider);


        };

        function commaSeparateNumber(val) {
            while (/(\d+)(\d{3})/.test(val.toString())) {
                val = val.toString().replace(/(\d+)(\d{3})/, '$1' + ',' + '$2');
            }
            return val;
        }
        function getPromotion_Cus(cusnc, period) {
            var current_status = $('.statuspromotion').text();
            if (current_status != "Untoggled") {
                $.ajax({
                    url: '@Url.Action("GetdataPromotion_Cus", "DataCenter")',
                    data: {
                        strcustome: cusnc,
                        period: period
                    },
                    type: "POST",
                    dataType: "JSON",
                    success: function (data) {
                        $('#promotiontbyearly tbody:last-child').html("");
                        $('#promotiontbquater tbody:last-child').html("");
                        $('#promotiontbother tbody:last-child').html("");
                        var SubmithtmlPage = "";
                        if (data.length > 0) {
                            for (var i = 0; i < data.length; i++) {
                                SubmithtmlPage += '<tr>';
                                SubmithtmlPage += '<td>' + data[i].Promotion_Name + '</td>';
                                SubmithtmlPage += '<td>' + commaSeparateNumber(data[i].Condition) + '</td>';
                                SubmithtmlPage += '<td>' + data[i].StartDate + '</td>';
                                SubmithtmlPage += '<td>' + data[i].EndDate + '</td>';
                                SubmithtmlPage += '<td>' + commaSeparateNumber(data[i].INVAMT) + '</td>';
                                SubmithtmlPage += '<td>' + commaSeparateNumber(data[i].RemainAmt) + '</td>';
                                SubmithtmlPage += '<td>' + data[i].Reward + '</td>';
                                SubmithtmlPage += '</tr>';
                            }
                            if (period == 'yearly') {

                                $("#promotiontbyearly").append(SubmithtmlPage);
                                $('#btn_yearly').css("background", "#910000");
                                $('#btn_quater').removeAttr('style');
                                $('#btn_other').removeAttr('style');

                            } else if (period == 'quater') {
                                $("#promotiontbquater").append(SubmithtmlPage);
                                $('#btn_yearly').removeAttr('style');
                                $('#btn_quater').css("background", "#910000");
                                $('#btn_other').removeAttr('style');
                            } else if (period == 'other') {
                                $("#promotiontbother").append(SubmithtmlPage);

                                $('#btn_yearly').removeAttr('style');
                                $('#btn_quater').removeAttr('style');
                                $('#btn_other').css("background", "#910000");
                            }
                        }
                    }
                });
            }
        }

        function getbackord(cusnc) {
                $.ajax({
                    url: '@Url.Action("getbackorder_notify", "CustomerDashboard")',
                    data: {
                        CUSCOD: cusnc,
                    },
                    type: "POST",
                    dataType: "JSON",
                    success: function (data) {
                        $('#backordtb tbody:last-child').html("");
                        if (data.message == "Y") {

                            if (data.backorder.length > 0) {
                                var SubmithtmlPage = "";

                                for (var i = 0; i < data.backorder.length; i++) {
                                    SubmithtmlPage += '<tr>';
                                    SubmithtmlPage += '<td><p class="cut-text m-0 p-0">' + data.backorder[i].STKCOD + ' / ' + data.backorder[i].STKDES + '</p></td>';
                                    SubmithtmlPage += '<td class="orgbck" style="text-align:center"><p class="m-0 p-0">' + data.backorder[i].Qty + '</p></td>';
                                    SubmithtmlPage += '<td><p class="m-0 p-0">' + data.backorder[i].SaleOrderDate + '</p></td>';
                                    SubmithtmlPage += '<td><p class="m-0 p-0">' + data.backorder[i].DeliveryDate + '</p></td>';
                                    SubmithtmlPage += '</tr >';
                                }
                                $("#backordtb").append(SubmithtmlPage);
                            } else if (data.length <= 0) {
                                SubmithtmlPage += '<tr><td class="text-center" colspan="6">-- ไม่พบข้อมูล --</td></tr>';
                                $("#backordtb").append(SubmithtmlPage);
                            }
                        }
                        else {
                            console.log(data.message);
                        }
                    }
                });
        }
