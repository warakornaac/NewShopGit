<!DOCTYPE html>
<html>
<head>
    <title>Menu</title>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">*@

    <link href="~/dashboard/assets/vendors/iconly/broken.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/dashboard/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/dashboard/assets/css/app.css">
    <link rel="shortcut icon" href="~/dashboard/assets/images/favicon.svg" type="image/x-icon">

    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">

    <link href="~/Content/Normalize.css" rel="stylesheet" />
    <script src="~/Scripts/webAddress.js"></script>
    <script src="~/Scripts/carousel-slider/js/jssor.slider-28.1.0.min.js"></script>


    <!-- Import jQuery 2.1.1 and jQuery UI CSS -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <!-- Import jQuery 2.1.1 -->
    <script src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
    <!-- Import jQuery UI 1.11.4 -->
    <script src="https://code.jquery.com/ui/1.11.4/jquery-ui.min.js"></script>
    @* <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>*@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <style>
        .font-kanit {
            font-family: Kanit;
        }

        .bg-teal {
            background-color: #1ED31E;
        }

        body {
            height: 100vh;
        }

        .header {
            background: #0dcaf0;
            color: white;
            text-align: center;
            padding: 10% 0;
            position: relative;
            clip-path: ellipse(75% 100% at 50% 0%);
        }

        h1 {
            font-size: 5em;
        }

        .title-text {
            font-size: 3em;
        }

        @@media only screen and (min-width: 767px) {
            .title-text {
                font-size: 2em;
            }
        }
    </style>
</head>
<body style="font-family: Kanit, sans-serif;">
    <div class="header">
        <h1 class="fw-bold" style="font-family: Kanit, sans-serif;">Customer Portal</h1>
    </div>
    <div class="container-fluid">
        <div class="card border-0">
            <div class="card-header text-center bg-white">
                @if (Session["DisplayName"].ToString() != "")
                {
                    <h1 class="font-kanit fw-bold">@Session["DisplayName"].ToString()</h1>
                }
            </div>
            <div class="card-body pt-2">
                <div class="row">
                    <div class="col-12 col-sm-6 col-md-6 mb-4 ">
                        <div class="card text-center p-4 bg-info w3-hover-khaki rounded text-white" id="menu_amt">
                            <i class="fa fa-shopping-cart fa-3x"></i>
                            <div class="card-body">
                                <h2 class=" font-kanit fw-bold title-text">ยอดซื้อ</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-6 mb-4">
                        <div class="card text-center p-4 bg-info  w3-hover-khaki text-white" id="menu_deliverytracking">
                            <i class="fa fa-shopping-bag fa-3x"></i>
                            <div class="card-body ">
                                <h2 class=" font-kanit fw-bold title-text">สถานะการสั่งซื้อ</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-6 mb-4">
                        <div class="card text-center p-4 bg-info  w3-hover-khaki text-white" id="menu_backorder">
                            <i class="fa fa fa-truck fa-3x"></i>
                            <div class="card-body">
                                <h2 class="font-kanit fw-bold title-text">สินค้าค้างส่ง</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-6 mb-4">
                        <div class="card text-center p-4 bg-info  w3-hover-khaki text-white" id="menu_promotion">
                            <i class="fa fa fa-product-hunt fa-3x"></i>
                            <div class="card-body">
                                <h2 class="font-kanit fw-bold title-text">โปรโมชั่น</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <script src="~/contentfilter/js/jquery-2.1.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.11.1/jquery-ui.min.js"></script>
    <script type="text/javascript">

        //ปุ่มยอดซื้อ
        $(document).on("click", "#menu_amt", function () {
            window.location.replace("../CustomerDashboard/index");
        });
        //ปุ่มสินค้าค้างส่ง
        $(document).on("click", "#menu_backorder", function () {
            window.location.replace("../CustomerDashboard/PendingDeliver");
        });
        //ปุ่มสถานะการสั่งซื้อ
        $(document).on("click", "#menu_deliverytracking", function () {
            window.location.replace("../CustomerDashboard/DeliveryTrack");
        });
        //ปุ่มรายการเคลม
        $(document).on("click", "#menu_warranty", function () {
            window.location.replace("../CustomerDashboard/Warranty");
        });
        //ปุ่มโปรโมชัน
        $(document).on("click", "#menu_promotion", function () {
            window.location.replace("../CustomerDashboard/Promotion");
        });
    </script>
</body>
</html>
