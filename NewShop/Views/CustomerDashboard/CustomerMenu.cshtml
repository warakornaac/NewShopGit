    function getDashBoard() {
        $.ajax({
            url: '@Url.Action("GetDashBoard", "CustomerDashboard")',
            data: {
                CUSCOD: cuscod
            },
            type: "POST",
            dataType: "JSON",
            beforeSend: function () {
                var stringLoad = "Loading...";
                $('#amt-text-first').text(stringLoad);
                $('#back-text-first').text(stringLoad);
                $('#service-text-first').text(stringLoad);
            },
            success: function (data) {
                var HtmlStringAmt = '';
                if (data.Getdata.length != 0) {
                    for (var i = 0; i < data.Getdata.length; i++) {
                        var item = data.Getdata[i];
                        console.log("TOPIC" + item.TopicID);
                        if (item.TopicID == "1") {
                            if (item.Seq == "1") {
                                $('#amt-text-first').text(item.Name + ' :');
                                $('#amt-all').text(commaSeparateNumber(Math.floor(item.Amt_Qty)));
                                getTop5(Math.floor(item.Amt_Qty));
                            }
                            if (item.Seq == "2") {
                                $('#amt-text-sec').text(item.Name + ' :');
                                $('#amt-discount').text(commaSeparateNumber(Math.floor(item.Amt_Qty)));
                            }
                            if (item.Seq.startsWith("3")) {
                                $('#amt-text-company').removeAttr("hidden");
                                HtmlStringAmt += '<span class="col-6 text-md font-weight-bold pl-4">' + item.Name + '</span> ';
                                HtmlStringAmt += '<span class="col-6 text-right text-md font-weight-bold" >' + commaSeparateNumber(Math.floor(item.Amt_Qty)) + '</span >';
                            }
                        }
                        if (item.TopicID == "3") {
                            if (item.Seq == "1") {
                                $('#back-text-first').text(item.Name + ' :');
                                $('#backorder-total').text(commaSeparateNumber(Math.floor(item.Amt_Qty)))
                            }
                            if (item.Seq == "2") {
                                $('#back-text-sec').text(item.Name + ' :');
                                $('#backorder-product').text(commaSeparateNumber(Math.floor(item.Amt_Qty)))
                            }
                            if (item.Seq == "3") {
                                $('#back-text-third').text(item.Name + ' :');
                                $('#backorder-money').text(commaSeparateNumber(Math.floor(item.Amt_Qty)))
                            }
                        }
                        if (item.TopicID == "4") {
                            if (item.Seq == "1") {
                                $('#service-text-first').text(item.Name + ' :');
                                $('#service-level-amt').text(commaSeparateNumber(Math.floor(item.Amt_Qty)));
                            }
                            if (item.Seq == "2") {
                                $('#service-text-sec').text(item.Name + ' :');
                                var servicePercent = item.Amt_Qty * 100;
                                $('#service-level-delivery').text(servicePercent.toFixed(2) + '%');
                            }
                        }
                    }
                    $('#company-amt').append(HtmlStringAmt);
                }
                else {
                    $('#amt-text-first').text("ไม่พบข้อมูล");
                    $('#back-text-first').text("ไม่พบข้อมูล");
                    $('#service-text-first').text("ไม่พบข้อมูล");
                }
            }
            ,
            error: function (jqXHR, textStatus, errorThrown) {
                console.log("Error: " + textStatus + " - " + errorThrown);
                alert("มีบางอย่างผิดพลาด กรุณาลองใหม่อีกครั้ง.");
            }
        });
    }

