    function getCusName() {
        $.ajax({
            url: '@Url.Action("GetdatabyCus", "CustomerDashboard")',
            data: {
                cusel: cuscod
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.length != 0) {
                    var head = $('#head-cusname');
                    var name = data[0].CUSNAM;
                    var club = data[0].CLUB;
                    if (club != "") {
                        head.text(name + '(' + club + ')');
                    }
                    else {
                        head.text(name);
                    }
                }
            }
        });
