    function getTop5() {
        $.ajax({
            url: '@Url.Action("GetDashBoard", "CustomerDashboard")',
            data: {
                CUSCOD: cuscod
            },
            type: "POST",
            dataType: "JSON",
            beforeSend: function () {
                $('#table-top5').html("");
                var Submithtml = "";
                Submithtml += '<tr>';
                Submithtml += '<td colspan="9" align="center"> <i class="fa fa-circle-o-notch fa-spin"></i> Loading...</td>';
                Submithtml += '</tr>';
                $('#table-top5').append(Submithtml);
            },
            success: function (data) {
                $('#table-top5').html("");
                var Submithtml = "";
                var countTop = 0;
                if (data.Getdata.length > 0) {
                    var j = 1;
                    for (var i = 0; i < data.Getdata.length; i++) {
                        var item = data.Getdata[i];
                        if (item.Topic == "Top 5") {
                            var styleColor = "";
                            ++countTop;
                            if (countTop == 1) {
                                styleColor = "text-success";
                            }
                            Submithtml += '<tr>';
                            //Submithtml += '<td>' + j + '</td>';
                            //Submithtml += '<td>' + item.Name + '</td>';
                            //Submithtml += '<td>' + commaSeparateNumber(item.Amt_Qty) + '</td>';
                            Submithtml += '<td class="text-md font-weight-bold ' + styleColor + ' ">' + countTop + '</td>';
                            Submithtml += '<td class="text-md font-weight-bold ' + styleColor + '">' + item.Name + '</td>';
                            Submithtml += '<td class="text-right text-md font-weight-bold ' + styleColor + '">' + commaSeparateNumber(item.Amt_Qty) + '</td>';
                            Submithtml += '</tr>';
                            j++;
                        }
                    }
                    $('#table-top5').append(Submithtml);
                }
            }
        });
    }

    function getDeliveryTrackAmt() {
        $.ajax({
             url: '@Url.Action("GetAlertDeliveryTracking", "CustomerDashboard")',
             data: {
                 CUSCOD: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (res) {
                if (res.message == "Y") {
                    var alert_accept = 0;
                    var alert_packing = 0;
                    var alert_delivery = 0;
                    var alert_arrive = 0;
                    var total_delivery = 0;
                    if (res.Getdata.length > 0) {
                        alert_accept = res.Getdata[0].Order;
                        alert_packing = res.Getdata[0].Pack;
                        alert_delivery = res.Getdata[0].Deliver;
                        alert_arrive = res.Getdata[0].Arrive;
                        total_delivery = alert_accept + alert_packing + alert_delivery + alert_arrive;
                        $('#total_deliverytrack').text(commaSeparateNumber(total_delivery));

                    }
                }
                else {
                    console.log(res.message);
                }
            }
        });
    }
    function getBackorderAmt() {
        var typeS = 0;
        var backorder = 0;
        var total = 0;
        $.ajax({
             url: '@Url.Action("getbackorder_S_notify", "CustomerDashboard")',
             data: {
                 CUSCOD: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (res) {
                if (res.message == "Y") {
                    if (res.backorder.length > 0) {
                        typeS = res.backorder.length;
                    }
                }
                else {
                    console.log("Error S : " + res.message);
                }
            }
        });
        $.ajax({
             url: '@Url.Action("getbackorder_notify", "CustomerDashboard")',
             data: {
                 CUSCOD: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (res) {
                if (res.message == "Y") {
                    if (res.backorder.length > 0) {
                        backorder = res.backorder.length;
                        total = typeS + backorder;
                        console.log("TypeS is :" + typeS);
                        console.log("BO is " + backorder);
                        $('#backorder-amt').text(commaSeparateNumber(total));
                    }
                }
                else {
                    console.log("Error S : " + res.message);
                }
            }
        });
    }
    function getWarrantyAmt() {
        var total = 0;
        $.ajax({
             url: '@Url.Action("GetdataWarrantyClaim_Cus_count", "DataCenter")',
             data: {
                 strcustome: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (data) {
                if (data.length > 0) {
                    var waiting = data[0].A != "" ? Number(data[0].A) :0;
                    var inprogress = data[0].B != "" ? Number(data[0].B) : 0;
                    var pending = data[0].C != "" ? Number(data[0].C) : 0;
                    total = waiting + inprogress + pending;
                    $('#warranty-amt').text(commaSeparateNumber(total));
                }
            }
        });
    }

