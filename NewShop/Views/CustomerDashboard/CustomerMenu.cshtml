    function shortenLabel(label, maxLength) {
        if (label.length > maxLength) {
            return label.substring(0, maxLength - 3) + "...";
        }
        return label;
        }

        function percentTop5Label(val,amt) {
            var percent = (val / amt) * 100;
            return commaSeparateNumber(percent.toFixed(2)) + '%';
        }

    function getTop5(amtAll) {
        $.ajax({
            url: '@Url.Action("GetDashBoard", "CustomerDashboard")',
            data: {
                CUSCOD: cuscod
            },
            type: "POST",
            dataType: "JSON",
            beforeSend: function () {
                $('#table-top5').html("");
                var Submithtml = "";
                Submithtml += '<tr>';
                Submithtml += '<td colspan="9" align="left"><span class="font-weight-bold">Loading...<span></td>';
                Submithtml += '</tr>';
                $('#table-top5').append(Submithtml);
            },
            success: function (data) {
                $('#table-top5').html("");
                var Submithtml = "";
                var countTop = 0;
                var labels = [];
                var dataValues = [];
                var colors = [];
                if (data.Getdata.length > 0) {
                    $('#top5-chart').removeAttr("hidden");
                    if (top5chart) {
                        top5chart.destroy();
                    }
                    for (var i = 0; i < data.Getdata.length; i++) {
                        var item = data.Getdata[i];
                        if (item.Topic == "Top 5") {
                            ++countTop;
                            labels.push(countTop + '.' + item.Name);
                            dataValues.push(Math.floor(item.Amt_Qty));


                            switch (countTop) {
                                case 1:
                                    colors.push('rgb(75, 192, 192)');
                                    break;
                                case 2:
                                    colors.push('rgb(54, 162, 235)');
                                    break;
                                case 3:
                                    colors.push('rgb(255, 99, 132)');
                                    break;
                                case 4:
                                    colors.push('rgb(255, 205, 86)');
                                    break;
                                case 5:
                                    colors.push('rgb(153, 102, 255)');
                                    break;
                                default:
                                    colors.push('rgb(201, 203, 207)');

                            }

                        }
                    }
                    var amtVals = dataValues.reduce((accumulator, currentValue) => {
                        return accumulator + currentValue
                    }, 0);

                    var ctx = document.getElementById('top5-chart').getContext('2d');
                    top5chart = new Chart(ctx, {
                        type: 'pie',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: dataValues,
                                backgroundColor: colors
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            layout: {
                                padding: {
                                    top: 0,
                                    left: 10,
                                    right: 10,
                                    bottom:0
                                }
                            },
                            plugins: {
                                legend: {
                                    position: 'bottom',

                                    display: true
                                },
                                legendDistance: {
                                    padding: 0
                                },
                                datalabels: {
                                    color: '#fff',
                                    formatter: (value, context) => {
                                        let label = context.chart.data.labels[context.dataIndex];
                                        return percentTop5Label(value, amtAll);
                                    },
                                    anchor: 'middle',
                                    align: 'start',
                                    offset: -40,
                                    font: {
                                        weight: 'bolder',
                                        size: 14
                                    },
                                    borderWidth: 0,
                                    borderColor: 'gray',
                                    borderRadius: 3,
                                    padding: 0,
                                    connectLines: {
                                        color: 'gray',
                                        angle: 90
                                    }
                                     //lineHeight: 1.2 // ปรับการเว้นบรรทัดระหว่างข้อความ (ถ้าจำเป็น)
                                }
                            }
                        },
                        plugins: [ChartDataLabels]
                    });




                }
            }
        });
    }

    function getDeliveryTrackAmt() {
        $.ajax({
             url: '@Url.Action("GetAlertDeliveryTracking", "CustomerDashboard")',
             data: {
                 CUSCOD: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (res) {
                if (res.message == "Y") {
                    var alert_accept = 0;
                    var alert_packing = 0;
                    var alert_delivery = 0;
                    var alert_arrive = 0;
                    var total_delivery = 0;
                    if (res.Getdata.length > 0) {
                        alert_accept = res.Getdata[0].Order;
                        alert_packing = res.Getdata[0].Pack;
                        alert_delivery = res.Getdata[0].Deliver;
                        alert_arrive = res.Getdata[0].Arrive;
                        total_delivery = alert_accept + alert_packing + alert_delivery + alert_arrive;
                        $('#total_deliverytrack').text(commaSeparateNumber(total_delivery));

                    }
                }
                else {
                    console.log(res.message);
                }
            }
        });
    }
    function getBackorderAmt() {
        var typeS = 0;
        var backorder = 0;
        var total = 0;
        $.ajax({
             url: '@Url.Action("getbackorder_S_notify", "CustomerDashboard")',
             data: {
