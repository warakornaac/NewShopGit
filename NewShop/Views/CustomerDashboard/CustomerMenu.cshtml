    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400;0,500;0,600;1,500&display=swap");

        html body {
            font-family: 'Kanit', sans-serif !important;
        }

        .font-kanit {
            font-family: Kanit;
        }

        .bg-teal {
            background-color: #1ED31E;
        }

        body {
            height: 100vh;
        }

        .header {
            background: #0dcaf0;
            color: white;
            text-align: center;
            padding: 10% 0;
            position: relative;
            clip-path: ellipse(75% 100% at 50% 0%);
        }

        h1 {
            font-size: 5em;
        }

        .title-text {
            font-size: 3em;
        }

        @@media only screen and (min-width: 767px) {
            .title-text {
                font-size: 2em;
            }
        }

        @@media (min-width: 768px) {
            .container, .container-sm, .container-md {
                max-width: 920px;
            }
        }
        /*        .container-fluid {
            min-width: 720px;
        }*/
        .card .card-body {
            font-family: Kanit;
        }

        .bg_card {
            /*background-color: #ceeaff;*/
            background-image: linear-gradient(39deg, #a4d0f1 0%, #afe9ff 100%);
            border: 2px solid #a6c1ff;
        }

        .bg_hov:hover {
            background-color: #ffcc00;
            border-radius: 15px;
            cursor: pointer;
            box-shadow: 0 8px 16px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);
        }

        .bg_hov:active {
            background-color: #997a00;
            border-radius: 10px;
        }

        .bg-yellow {
            background-color: #e2e600;
        }

        .bg-backorder {
            background-color: #9FE2BF;
        }
    </style>
    <style>
        #scroll-container {
            overflow: hidden;
        }

        .scroll-text {
            display: inline-block;
            /* animation properties */
            -moz-transform: translateX(100%);
            -webkit-transform: translateX(100%);
            transform: translateX(100%);
            -moz-animation: my-animation 30s linear infinite;
            -webkit-animation: my-animation 30s linear infinite;
            animation: my-animation 30s linear infinite;
        }

        /* for Firefox */
        @@-moz-keyframes my-animation {
            from {
                -moz-transform: translateX(100%);
            }

            to {
                -moz-transform: translateX(-120%);
            }
        }

        /* for Chrome */
        @@-webkit-keyframes my-animation {
            from {
                -webkit-transform: translateX(100%);
            }

            to {
                -webkit-transform: translateX(-120%);
            }
        }

        @@keyframes my-animation {
            from {
                -moz-transform: translateX(100%);
                -webkit-transform: translateX(100%);
                transform: translateX(100%);
            }

            to {
                -moz-transform: translateX(-120%);
                -webkit-transform: translateX(-120%);
                transform: translateX(-120%);
            }
        }

        .pause-animation {
            -moz-animation-play-state: paused;
            -webkit-animation-play-state: paused;
            animation-play-state: paused;
        }

        .stroke-text {
            -webkit-text-stroke-width: 0.5px;
            -webkit-text-stroke-color: black;
        }

        .text-indigo {
            color: #6f42c1;
        }

        .text-tac {
            color: #0d6efd;
        }

        #table-top5 tr {
            line-height: 14px;
        }
    </style>
</head>
