    function getWarrantyAmt() {
        var total = 0;
        $.ajax({
             url: '@Url.Action("GetWarrantyCount", "CustomerDashboard")',
             data: {
                 CUSCOD: cuscod
             },
             type: "POST",
            dataType: "JSON",
            success: function (data) {
                if (data.length > 0) {
                    var waiting = data[0].A != "" ? data[0].A : "0";
                    var inprogress = data[0].B != "" ? data[0].B : "0";
                    var approve = data[0].C != "" ? data[0].C : "0";
                    var refuse = data[0].D != "" ? data[0].D : "0";
                    total = Number(waiting) + Number(approve) + Number(refuse);
                    $('#warranty-amt').text(commaSeparateNumber(total));
                }
            }
        });
        }


