@{
    var startYear = DateTime.Now.Year - 2;
    var endYear = DateTime.Now.Year;
}
<style>
    .textCut {
        display: inline-block;
        width: 220px;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }

    .vcenter {
        text-align: center;
        vertical-align: middle !important;
    }

    .vright {
        text-align: right;
        vertical-align: middle !important;
    }

    .table-style thead th {
        position: sticky;
        top: 0;
        background-color: white;
        z-index: 3 !important;
    }

    .table-scroll thead tr:nth-child(2) th {
        top: 30px;
    }
</style>
<div class="m-0 table-style table-responsive table-scroll" style="height: 500px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-hover mb-0 " id="table-history" style="padding: 7px;font-size: small;">
        <thead class="thead-default" style="font-size: small;">
            <tr>
                <th rowspan="2" class="vcenter"><span>บริษัท</span></th>
                <th rowspan="2" class="vcenter"><span>เบอร์สินค้า</span></th>
                <th rowspan="2" class="vcenter"><span>ชื่อสินค้า</span></th>
                @for (int i = endYear; i >= startYear; i--)
                {
                    <th colspan="2" class="vcenter"> @i </th>
                }
                <th rowspan="2" class="vcenter"> แบรนด์ </th>
            </tr>
            <tr>
                @for (int i = 1; i <= 3; i++)
                {
                    <th class="vcenter"> จำนวน </th>
                    <th class="vcenter"> ราคารวม </th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (ViewBag.Getdata.Count == 0)
                {
                    <tr>
                        <td colspan="10" style="text-align:center;"> -- ไม่พบข้อมูล -- </td>
                    </tr>
                }
                else
                {
                    int rowShop = 1;
                    foreach (var rowData in ViewBag.Getdata)
                    {
                        <tr>
                            <td style="text-align:center;">@rowData.Company</td>
                            <td>@rowData.Stkcod</td>
                            <td> <span class="textCut"> @rowData.Stkdes </span> </td>

                            @for (int i = 1; i <= 3; i++)
                            {
                                string valQty = "-";
                                string valAmt = "-";

                                switch (i)
                                {
                                    case 1:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_1_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_1_amt));
                                        break;
                                    case 2:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_2_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_2_amt));
                                        break;
                                    case 3:
                                        valQty = string.Format("{0:n0}", Convert.ToDouble(rowData.year_3_qty));
                                        valAmt = string.Format("{0:n0}", Convert.ToDouble(rowData.year_3_amt));
                                        break;
                                    default:
                                        valQty = "";
                                        valAmt = "";
                                        break;
                                }
                                <td class="vright">
                                    @if (@valQty != "0")
                                    {
                                        @valQty
                                    }
                                </td>
                                <td class="vright">
                                    @if (valAmt != "0")
                                    {
                                        @valAmt
                                    }
                                </td>
                            }
                            <td class="vcenter"> @rowData.Brand </td>
                        </tr>
                        rowShop++;
                    }
                }
            }
        </tbody>
    </table>
</div>
