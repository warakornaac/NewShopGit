<style>
    .textCus {
        /*display: inline-block;*/
        width: 200px;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }
</style>
<div class="m-0 table-style table-responsive" style="height: 500px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-hover mb-0 " id="table-history" style="padding: 7px;font-size: small;">
        <thead style="font-size: small;">
            <tr>
                <th style="text-align:center;"><span>บริษัท</span></th>
                <th><span>เบอร์สินค้า</span></th>
                <th><span>ชื่อสินค้า</span></th>
                <th><span>ปี</span></th>
                <th><span>จำนวน</span></th>
                <th><span>ราคารวม</span></th>
                <th><span>แบรนด์</span></th>
            </tr>
        </thead>
        <tbody>
            @{
                if (ViewBag.Getdata.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align:center;"> -- ไม่พบข้อมูล -- </td>
                    </tr>
                }
                else
                {
                    int rowShop = 1;
                    foreach (var rowData in ViewBag.Getdata)
                    {
                        <tr>
                            <td style="text-align:center;"><span>@rowData.Company</span></td>
                            <td><span>@rowData.Stkcod</span></td>
                            <td class="textCus"><span>@rowData.Stkdes</span></td>
                            <td><span>@rowData.Year</span></td>
                            <td style="text-align:center;"><span>@rowData.Qty</span></td>
                            <td style="text-align:right;"><span>@rowData.Amt</span></td>
                            <td><span>@rowData.Brand</span></td>
                        </tr>
                        rowShop++;
                    }
                }
            }
        </tbody>
    </table>
</div>
