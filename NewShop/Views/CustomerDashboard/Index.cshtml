                                    SubmithtmlPage += '</tr>';
                                    SubmithtmlPage += '<tr>';
                                    SubmithtmlPage += '<td colspan="4" class="hiddenRow">'
                                    SubmithtmlPage += '<div class="accordian-body collapse table-responsive" id="col-detail-' + i + '"> ';
                                    SubmithtmlPage += '<table class="table table-sm table-striped table-bordered table-hover " id="sec-table-' + i + '">';
