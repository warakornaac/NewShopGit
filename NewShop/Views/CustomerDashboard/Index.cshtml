        function parseDate(dateStr) {
            if (!dateStr) return null;
            // var parts = dateStr.split('/');
            var parts = dateStr.includes('-') ? dateStr.split('-') : dateStr.split('/');
            var day = parseInt(parts[0], 10) + 1;
            var month = parseInt(parts[1], 10) - 1;
            var year = parseInt(parts[2], 10);
            var date = new Date(year, month, day);
            return isNaN(date.getTime()) ? null : date;
        }
        function getBillingDue() {

            var aacdue = $('#aac-bildue-date').text();
            var tacdue = $('#tac-bildue-date').text();
            var ompdue = $('#omp-bildue-date').text();
            //console.log('aac : ' + aacdue);
            //console.log('tac : ' + tacdue);
            //console.log('omp : ' + ompdue);


            var dates = [parseDate(aacdue), parseDate(tacdue), parseDate(ompdue)].filter(date => date !== null);
            if (dates.length > 0) {
                var minDate = new Date(Math.min.apply(null, dates));
                var maxDate = new Date(Math.max.apply(null, dates));

                $.ajax({
                    url: '@Url.Action("GetBilling", "CustomerDashboard")',
                    data: {
                        CUSCOD: cuscod,//cuscod
                        DueDatMin: minDate.toISOString().split('T')[0],
                        DueDatMax: maxDate.toISOString().split('T')[0]
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    beforeSend: function () {
                        $('#bildue-table tbody').html("");
                        var SubmithtmlPage = "";
                        SubmithtmlPage += '<tr>';
                        SubmithtmlPage += '<td colspan="4">Loading....</td>';
                        SubmithtmlPage += '<tr>';
                        $('#bildue-table tbody').append(SubmithtmlPage);
                    },
                    success: function (data) {
                        if (data.message == 'Y') {
                            $('#bildue-table tbody').html("");
                            var SubmithtmlPage = "";
                            if (data.Getdata.length != 0) {
                                for (var i = 0; i < data.Getdata.length; i++) {
                                    SubmithtmlPage += '<tr>';
                                    SubmithtmlPage += '<td>' + data.Getdata[i].Company + '</td>';
                                    SubmithtmlPage += '<td>' + data.Getdata[i].Invnum + '</td>';
                                    SubmithtmlPage += '<td>' + data.Getdata[i].BillDue + '</td>';
                                    SubmithtmlPage += '<td>' + data.Getdata[i].Amt + '</td>';
                                    SubmithtmlPage += '</tr>';
                                }
                                $('#bildue-table tbody').append(SubmithtmlPage);
                            }
                            else {
                                $('#bildue-table tbody').html("");
                                var SubmithtmlPage = "";
                                SubmithtmlPage += '<tr>';
                                SubmithtmlPage += '<td colspan="5">ไม่พบข้อมูล</td>';
                                SubmithtmlPage += '<tr>';
                                $('#bildue-table tbody').append(SubmithtmlPage);
                            }
                        }
                        else {
                            console.log(data.message);
                        }
                    }

                });
            }
            else {
                console.log('Error!!!');
            }

        }

