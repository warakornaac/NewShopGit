        function getCreditCus(cus) {
            $.ajax({
                url: '@Url.Action("Credit_Cus", "CustomerDashboard")',
                data: {
                    cuscod: cus
                },
                type: "POST",
                dataType: "JSON",
                success: function (data) {
                    if (data.message == 'Y') {
                        //console.log("NAME : " + data.credits[0].CUSNAME);
                        var aaccrbal = data.credits[0].AACCRLINE;
                        var taccrbal = data.credits[0].TACCRLINE;
                        var ompcrbal = data.credits[0].OMPCRLINE;

                        var aacbal = data.credits[0].AACBAL;
                        var tacbal = data.credits[0].TACBAL;
                        var ompbal = data.credits[0].OMPBAL;

                        var resaacbal = Number(aaccrbal) - Number(aacbal);
                        var restacbal = Number(taccrbal) - Number(tacbal);
                        var resompbal = Number(ompcrbal) - Number(ompbal);


                        var aacbaldue = data.credits[0].AACBALDue;
                        var tacbaldue = data.credits[0].TACBALDue;
                        var ompbaldue = data.credits[0].OMPBALDue;

                        var creditdue = data.credits[0].AACPAYTR;



                        $('#credit-duedate').text(creditdue);


                        $('#aac-crline').text(commaSeparateNumber(aaccrbal));
                        $('#tac-crline').text(commaSeparateNumber(taccrbal));
                        $('#omp-crline').text(commaSeparateNumber(ompcrbal));

                        $('#aac-bal').text(commaSeparateNumber(aacbal));
                        $('#tac-bal').text(commaSeparateNumber(tacbal));
                        $('#omp-bal').text(commaSeparateNumber(ompbal));

                        $('#aac-res').text(commaSeparateNumber(resaacbal.toString()));
                        $('#tac-res').text(commaSeparateNumber(restacbal.toString()));
                        $('#omp-res').text(commaSeparateNumber(resompbal.toString()));

                        $('#aac-baldue').text(commaSeparateNumber(aacbaldue));
                        $('#tac-baldue').text(commaSeparateNumber(tacbaldue));
                        $('#omp-baldue').text(commaSeparateNumber(ompbaldue));
                    }
                    else {
                        console.log(data.message);
                    }
                }
            })
        }
