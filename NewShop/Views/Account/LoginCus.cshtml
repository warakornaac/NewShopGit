            font-size: 24px;
            text-align: center;
            font-weight: 400;
            background-color: #fff;
            padding-left: 0;
            padding-right: 0;
            height: 60px;
            -webkit-border-radius: 10px;
            -moz-border-radius: 10px;
            border-radius: 10px;
        }

        .otp p {
            text-align: center;
            opacity: .8;
            margin: 0;
        }
    </style>
</head>
