@{
    ViewBag.Title = "LoginCus";
    string domainName = HttpContext.Current.Request.Url.GetLeftPart(UriPartial.Authority);
    string _lineUser = ViewBag.Userlineid;
}
<html lang="en">
<head>
    <title>LogIn</title>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <style>
        a, a:hover {
            color: #333
        }

        .warning-red {
            color: red;
        }

        .red-star {
            color: red;
        }

        .bg-login-color-redient {
            background: linear-gradient(0deg, rgba(255,255,255,1) 0%, rgba(0,123,255,1) 100%);
        }

        .disable-link {
            pointer-events: none;
            cursor: default;
            color: dimgray;
        }

        .otp {
            margin: 5px;
            text-align: center;
        }

        @@media only screen and (min-width: 412px) {
            .otp {
                height: 50px;
                width: 50px;
            }
        }

        @@media only screen and (min-width: 375px) {
            .otp {
                height: 40px;
                width: 40px;
            }
        }

        @@media only screen and (max-width: 374px) {
            .otp {
                height: 30px;
                width: 30px;
            }
        }

        .otp-form {
            display: flex;
            flex-flow: row wrap;
            align-items: center;
        }
    </style>
</head>
<body class="bg-login-color-redient">
    <div class="container">
        <div class="d-flex justify-content-center align-items-center vh-100">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">เข้าสู่ระบบ</h3>
                    <input type="hidden" id="phone" />
                    <input type="hidden" id="cuscod" />
                    <input type="hidden" id="email" />
                    <input type="hidden" id="lineid" />
                    @*<button class="btn btn-info" type="button" id="test_open" onclick="">otp TEST</button>*@
                </div>
                <form class="form-horizontal" action="~/Account/LoginCus" method="post">
                    <div class="card-body">
                        <div class="form-group row">
                            <label for="inputUser" class="col-sm-4 col-form-label">Username / Email</label>
                            <div class="col-sm-8">
                                @*<div class="col-sm-8 d-flex align-items-center">*@
                                <div class="input-group">
                                    <input type="text" class="form-control" id="inputusername" name="User" placeholder="Email/Username">
                                </div>
                                <p class="warning-red" id="wronguser" hidden>Username หรือ Email ไม่ถูกต้อง</p>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="inputPassword3" class="col-sm-4 col-form-label">Password</label>
                            <div class="col-sm-8">
                                <div class="input-group" id="show_hide_password">
                                    <input type="password" class="form-control" id="inputPassword" name="password" placeholder="Password">
                                    <div class="input-group-append ">
                                        <a href="" class="btn border d-flex align-items-center justify-content-center"><i class="fa fa-eye-slash" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                                <p class="warning-red" id="wrongpass" hidden>Password ไม่ถูกต้อง</p>
                            </div>
                        </div>
                        <div class="form-group row" hidden>
                            <div class="offset-sm-2 col-sm-10">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="remember">
                                    <label class="form-check-label" for="remember">Remember me</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn btn-info float-right" onclick="Login();">Sign in</button>
                        @*<button type="reset" class="btn btn-default float-right">Cancel</button>*@
                    </div>
                </form>
                <div class="otp-content">

                </div>
                @*OTP MODAL*@
                <!-- Modal -->
                <div class="modal fade" id="OtpModalCenter" tabindex="-1" role="dialog" aria-labelledby="ModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="OtpModalLongTitle">ยืนยันตัวตน</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body d-flex justify-content-center">
                                <table>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="row">
                                                    <label class="col-12 " style="opacity:0.5;">
                                                        กรุณากดปุ่ม "ขอรหัส OTP" กรอกรหัส OTP ที่ได้รับทาง SMS ด้านล่างเพื่อยืนยันตัวตน หากไม่ได้รับรหัส OTP กรุณาตรวจสอบเบอร์โทรศัพท์มือถือด้านล่างให้ถูกต้องและกดปุ่ม "ขอรหัส OTP" อีกครั้ง
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                กรอกรหัส OTP<span class="red-star">*</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="row">
                                                    <div class="col-6">
                                                        <input type="text" id="otpphone" class="form-control" readonly />
                                                    </div>
                                                    <div class="col-6">
                                                        <button class="btn btn-success" id="sendotp_btn" onclick="delaySendOtp(); sendOtp();">ขอรหัส OTP</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>

                                                <div class="otp-form">
                                                    <input type="tel" class="otp form-control" id="enterotp1" pattern="[0-9]+" maxlength="1">
                                                    <input type="tel" class="otp form-control" id="enterotp2" pattern="[0-9]+" maxlength="1">
                                                    <input type="tel" class="otp form-control" id="enterotp3" pattern="[0-9]+" maxlength="1">
                                                    <input type="tel" class="otp form-control" id="enterotp4" pattern="[0-9]+" maxlength="1">
                                                    <input type="tel" class="otp form-control" id="enterotp5" pattern="[0-9]+" maxlength="1">
                                                    <input type="tel" class="otp form-control" id="enterotp6" pattern="[0-9]+" maxlength="1">
                                                </div>
                                                <p class="m-0" id="refid"><span id="refhead">Ref : </span><span id="ref_show"></span> </p>
                                                <p class="mb-0" hidden id="count_p">รหัส OTP มีอายุอีก <span id="login-counter">05:00</span> <span id="label-countdown">นาที</span></p>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                @*<a href="#" id="sendotp" name="sendotp" onclick="delaySendOtp(); sendOtp();">ส่งรหัสยืนยันผ่าน SMS อีกครั้ง</a>*@
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div id="countdown" style="color:red;"></div>
                                                <p class="red-star" hidden="">รหัสไม่ถูกต้อง</p>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="pt-3">
                                                <div class="d-flex justify-content-end">
                                                    <button class="btn btn-success" id="otpcheck" onclick="otpCheck();">
                                                        Verify
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @*<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>*@
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
    <script>
        const queryString = decodeURIComponent(window.location.search);
        const params = new URLSearchParams(queryString);
        const page = params.get('page');
        console.log("Page: " + page);
        console.log("Line : " + '@_lineUser');
        var sessionLine = '@Request.RequestContext.HttpContext.Session["Line"]';
        $('#lineid').val(sessionLine);
        function testPress() {
            var amount = $('#enterotp6');
            var pes = amount.val();
            var otpValues = '';

            if (pes !== "") {
                if (!isNaN(pes)) {
                    $('.otp').each(function () {
                        otpValues += $(this).val();
                    });
                    alert("OTP is " + otpValues);
                }
            }
        }

        $(document).ready(function () {
            var inputs = $('.otp');
            inputs.on('input', function () {
                if (isNaN(parseInt($(this).val()))) {
                    $(this).val('');
                } else {
                    if ($(this).val() !== '' && inputs.index(this) < inputs.length - 1) {
                        inputs.eq(inputs.index(this) + 1).select();
                    }
                }
            });
            inputs.on('click', function () {
                $(this).select();
            });
        });

        $(document).ready(function () {
            $("#show_hide_password a").on('click', function (event) {
                event.preventDefault();
                if ($('#inputPassword').attr("type") == "text") {
                    $('#inputPassword').attr('type', 'password');
                    $('#show_hide_password i').addClass("fa-eye-slash");
                    $('#show_hide_password i').removeClass("fa-eye");
                } else if ($('#inputPassword').attr("type") == "password") {
                    $('#inputPassword').attr('type', 'text');
                    $('#show_hide_password i').removeClass("fa-eye-slash");
                    $('#show_hide_password i').addClass("fa-eye");
                }
            });
        });
        $(document).ready(function () {
            $('#inputusername').change(function () {
                $('#wronguser').attr('hidden', true);
            });
            $('#inputPassword').change(function () {
                $('#wrongpass').attr('hidden', true);
            });
        });

        function Login() {
            $('#count_p').attr('hidden', true);
            $('#ref_show').attr('hidden', true);
            var username = $('#inputusername').val();
            var pass = $('#inputPassword').val();
            var phonenum = $('#phone').val();
            var cuscod = '';
            $.ajax({
                url: '@Url.Action("LoginCus","Account")',
                data: JSON.stringify({
                    User: username,
                    password: pass,
                    page: page
                }),
                type: "POST",
                cache: false,
                dataType: 'json',
                traditional: true,
                contentType: "application/json; charset=utf-8",
                processData: false,
                beforeSend: function () {

                },
                success: function (result) {
                    if (result.message == "Y") {
                        console.log("Result is " + result.message);
                        if (result.page != null && result.page != '') {
                            if (result.page == "amount") { //หน้ายอดซื้อ
                                //alert("amount");
                                //window.location.assign("@domainName" + "/CustomerDashboard/index");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/index");
                            } else if (page == "promotion") {//หน้าโปรโมชั่น
                                //window.location.assign("@domainName" + "/CustomerDashboard/Promotion");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/Promotion");
                            }
                            else if (page == "PendingDelivery") {//หน้าค้างส่ง
                                //window.location.assign("@domainName" + "/CustomerDashboard/PendingDeliver");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/PendingDeliver");
                            }
                        }
                    }
                    else if (result.message == "N") {
                        phonenum = result.tel;
                        console.log("N Result " + result.message);
                        console.log("Phone is " + phonenum);
                        console.log("cuscod is " + result.cuscod);
                        console.log("Line : ");
                        $('#phone').val(phonenum);
                        $('#otpphone').val(phonenum);
                        $('#cuscod').val(result.cuscod);

                        $('.modal').modal('show');
                    }
                    else {
                        $('#wronguser').removeAttr('hidden');
                        $('#wrongpass').removeAttr('hidden');
                        console.log("Error");
                    }
                },
                error: function (er) {

                },
                complete: function (res) {

                }
            }).fail(function (ex) {
                console.log("fail");
            });
        }
        //count OTP
        var counter;
        function delaySendOtp() {
            var reff = generateRef(4);
            $('#ref_show').removeAttr('hidden');
            $('#count_p').removeAttr('hidden');
            $('#ref_show').text(reff);
            $('#sendotp').addClass("disable-link");
            resetCountdown();
        }
        function startCountdown() {
            counter = setInterval(function () {
                var minutes = Math.floor(countDownTime / 60000);
                var seconds = Math.floor((countDownTime % 60000) / 1000);
                $('#login-counter').text(pad(minutes) + ':' + pad(seconds));
                countDownTime -= 1000;
                if (countDownTime < 0) {
                    clearInterval(counter);
                    $('#login-counter').text('00:00');
                    $('#label-countdown').text('');
                }
            }, 1000);
        }
        function resetCountdown() {
            clearInterval(counter);
            countDownTime = 5 * 60 * 1000;
            startCountdown();
        }
        function pad(val) {
            return val < 10 ? '0' + val : val;
        }
        ////////


        function otpCheck() {
            var otpenter = '';
            $('.otp').each(function () {
                otpenter += $(this).val();
            });
            var phone = $('#otpphone').val();
            var refer = $('#ref_show').text();
            var username = $('#inputusername').val();
            var line = $('#lineid').val();
            //alert("Otp is : " + otpenter);
            console.log("OP : " + otpenter);
            console.log("LineUserId : " + line)
            $.ajax({
                url: '@Url.Action("Verify", "Verification")',
                data: JSON.stringify({
                    lineid:line,
                    phone: phone,
                    user: username,
                    otp: otpenter,
                    refer: refer,
                    page:page
                }),
                type: "POST",
                cache: false,
                dataType: 'json',
                traditional: true,
                contentType: "application/json; charset=utf-8",
                processData: false,
                beforeSend: function () {

                },
                success: function (result) {
                    if (result.message == 'Y') {
                        //alert("login Success!!!" + "Page : " + result.page);
                        if (result.page != null && result.page != '') {
                            if (result.page == "amount") { //หน้ายอดซื้อ
                                //alert("amount");
                                //window.location.assign("@domainName" + "/CustomerDashboard/index");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/index");
                            } else if (page == "promotion") {//หน้าโปรโมชั่น
                                ////window.location.assign("@domainName" + "/CustomerDashboard/Promotion");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/Promotion");
                            }
                            else if (page == "PendingDelivery") {//หน้าค้างส่ง
                                ////window.location.assign("@domainName" + "/CustomerDashboard/PendingDeliver");
                                window.location.assign("@domainName" + "/MobileCatalog_Test/CustomerDashboard/PendingDeliver");
                            }
                        }
                    }
                    else {
                        alert(result.message);
                    }
                },
                error: function (er) {

                },
                complete: function (res) {

                }

            }).fail(function (ex) {
                console.log("fail");
            });
        }
        function sendOtp() {
            var reff = generateRef(4);
            var phone = $('#phone').val();
            var mail = $('#email').val();
            var username = $('#inputusername').val();
            var cuscod = $('#cuscod').val();
            $('#ref_show').text(reff);
            $.ajax({
                url: '@Url.Action("SendOtp", "Verification")',
                data: JSON.stringify({
                    phone: phone,
                    user: username,
                    refer: reff
                }),
                type: "POST",
                cache: false,
                dataType: 'json',
                traditional: true,
                contentType: "application/json; charset=utf-8",
                processData: false,
                beforeSend: function () {

                },
                success: function (result) {
                    if (result.status == "Y") {
                        console.log("API res : " + result.Apisend);
                        //if (result.Apisend == "200")
                        //    alert("Send Success");
                        //else
                        //    alert("Fail");
                    }
                    else {
                        alert(result.message);
                    }
                },
                error: function (er) {

                },
                complete: function (res) {

                }

            }).fail(function (ex) {
                console.log("fail");
            });
        }
        function generateRef(length) {
            var result = '';
            var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
            var charactersLength = characters.length;
            for (var i = 0; i < length; i++) {
                result += characters.charAt(Math.floor(Math.random() * charactersLength));
            }
            return result;
        }
    </script>
</body>
</html>