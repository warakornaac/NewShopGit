@model NewShop.Models.LoginUserViewModel
@{ // บังคับแสดง captcha ทุกครั้ง ไม่มีเงื่อนไขอีกต่อไป
    bool showRecaptcha = true; }
<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Login</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/tmartcss/css/bootstrap.min.css">
    <link href="~/cardoorcss/css/font-awesome.css" rel="stylesheet" />
    <script src="~/tmartcss/js/vendor/modernizr-2.8.3.min.js"></script>
    <script src="~/tmartcss/js/vendor/jquery-1.12.0.min.js"></script>
    <script src="~/tmartcss/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(-120deg, #ef3b13fa, #1a30d0);
            background-repeat: no-repeat;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.18);
            margin: 2rem auto;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.8rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #f0f0f0;
            justify-content: center
        }

            .logo-area img {
                width: 155px;
                height: auto;
            }

        .env-badge {
            font-size: 11px;
            color: #1a30d0;
            background: #eef0fb;
            border-radius: 6px;
            padding: 3px 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .login-heading {
            font-size: 21px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 4px;
            justify-content: center
        }

        .login-sub {
            font-size: 13px;
            color: #999;
            margin-bottom: 1.8rem;
        }

        .field-label {
            font-size: 11px;
            font-weight: 700;
            color: #777;
            margin-bottom: 5px;
            display: block;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .field-wrap {
            position: relative;
            margin-bottom: 1.2rem;
        }

            .field-wrap input {
                width: 100%;
                padding: 10px 40px 10px 14px;
                border: 1.5px solid #e8e8e8;
                border-radius: 10px;
                font-size: 14px;
                color: #1a1a2e;
                outline: none;
                transition: border 0.2s;
                background: #fafafa;
            }

                .field-wrap input:focus {
                    border-color: #1a30d0;
                    background: #fff;
                }

        .field-icon-new {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #bbb;
            font-size: 15px;
            z-index: 2;
        }

        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin: 1rem 0 1.2rem;
        }

            .terms-row input[type=checkbox] {
                margin-top: 2px;
                accent-color: #1a30d0;
                width: 15px;
                height: 15px;
                flex-shrink: 0;
                cursor: pointer;
            }

            .terms-row label {
                font-size: 12px;
                color: #777;
                line-height: 1.5;
                cursor: pointer;
            }

        .btn-login-new {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: none;
            font-size: 15px;
            font-weight: 600;
            background: linear-gradient(-120deg, #ef3b13, #1a30d0);
            color: #fff;
            transition: opacity 0.2s;
        }

        .error-text {
            color: #e74c3c;
            font-size: 12px;
            margin-top: 4px;
        }
        /* เทคนิคดักจับ Chrome autofill โดยใช้ animation trick */
        @@keyframes onAutoFillStart {
            from {
            }

            to {
            }
        }

        input:-webkit-autofill {
            animation-name: onAutoFillStart;
            animation-duration: 0.001s;
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="logo-area">
            <img src="~/images/logo/AACTAC185x70.jpg" alt="AAC TAC Logo" />
        </div>


        <div class="login-heading" style="text-align:center">เข้าสู่ระบบ</div>
        <div class="login-sub" style="text-align:center">กรุณากรอกข้อมูลเพื่อเข้าใช้งาน</div>

        @using (Html.BeginForm("LogIn", "Account", FormMethod.Post, new { id = "loginForm" })) {
    <label class="field-label">Username</label>
                    <div class="field-wrap">
                        @Html.TextBoxFor(u => u.Usre, new { required = "required", @class = "form-control", placeholder = "กรอก Username" })
                        @Html.ValidationMessageFor(u => u.Usre, "", new { @class = "error-text" })
                    </div>

                                    <label class="field-label">Password</label>
                                                    <div class="field-wrap">
                                                        @Html.PasswordFor(u => u.Password, new { required = "required", @class = "form-control", @id = "password-field", placeholder = "กรอก Password" })
                                                        <span toggle="#password-field" class="fa fa-fw fa-eye field-icon-new toggle-password"></span>
                                                        @Html.ValidationMessageFor(u => u.Password, "", new { @class = "error-text" })
                                                    </div>

                                                                    <div style="color:#e74c3c; font-size:12px; margin-bottom:8px;">
                                                                        @Html.ValidationSummary(true, "Login Failed, check details")
                                                                    </div>

                                                                                    @Html.Hidden("Latitude")
                                                                                                    @Html.Hidden("Longitude")

                                                                                                                    <div id="recaptchaWrapper" style="margin-bottom: 14px; justify-items: center;">
                                                                                                                        <div class="g-recaptcha"
                                                                                                                             data-sitekey="@System.Configuration.ConfigurationManager.AppSettings["RecaptchaSiteKey"]"
                                                                                                                             data-callback="onRecaptchaSuccess"
                                                                                                                             data-expired-callback="onRecaptchaExpired">
                                                                                                                        </div>
                                                                                                                    </div> <!-- แทนที่ปุ่ม Login ด้วยข้อความสถานะ -->
                                                                                                                                    <div id="statusText" style="text-align:center; font-size:13px; color:#999; padding:10px 0;">
                                                                                                                                        กรุณายืนยัน reCAPTCHA เพื่อเข้าสู่ระบบอัตโนมัติ
                                                                                                                                    </div> <!-- ปุ่มจริง ซ่อนไว้ก่อน -->
                                                                                                                                                    <input type="submit" id="btnLogin" value="เข้าสู่ระบบ" class="btn-login-new"
                                                                                                                                                           style="display:none;" />}

    </div>

    @if (TempData["ErrorMessage"] != null) {
        var errMsg = TempData["ErrorMessage"].ToString();
<script>
        Swal.fire({
            icon: 'warning',
            title: 'Login Fail',
            text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(errMsg)),
            confirmButtonText: 'OK',
            confirmButtonColor: '#d33'
        });
</script>}

    <script type="text/javascript">
    $(".toggle-password").click(function () {
        $(this).toggleClass("fa-eye fa-eye-slash");
        var input = $($(this).attr("toggle"));
        input.attr("type", input.attr("type") == "password" ? "text" : "password");
    });

    var isAutoSubmitted = false;
    var recaptchaVerified = false;

    function tryAutoSubmit() {
        if (isAutoSubmitted) return;

        if (!recaptchaVerified) {
            $('#statusText').text('กรุณายืนยัน reCAPTCHA เพื่อเข้าสู่ระบบ').css('color', '#999');
            return;
        }

        isAutoSubmitted = true;
        $('#statusText').text('ยืนยันสำเร็จ กดปุ่มหรือกด Enter เพื่อเข้าสู่ระบบ').css('color', '#1a30d0');
        $('#btnLogin').fadeIn(200, function () {
            // ✅ focus ปุ่มทันทีที่โผล่ขึ้นมา - user กด Enter ได้เลยโดยไม่ต้องคลิกเมาส์
            $('#btnLogin').focus();
        });
    }

    function onRecaptchaSuccess() {
        console.log('=== reCAPTCHA success triggered ===');

        // บังคับ commit ค่าอีกรอบก่อนอ่าน เผื่อกรณี user ไม่เคยคลิกอะไรมาก่อนเลย
        $('#Usre').trigger('focus').trigger('blur');
        $('#password-field').trigger('focus').trigger('blur');

        console.log('Usre value:', $('#Usre').val());
        console.log('password value:', $('#password-field').val());

        recaptchaVerified = true;
        setTimeout(function () {
            tryAutoSubmit();
        }, 200);;
    }

    function onRecaptchaExpired() {
        recaptchaVerified = false;
        isAutoSubmitted = false;
        $('#btnLogin').hide();
        $('#statusText').text('reCAPTCHA หมดอายุ กรุณายืนยันใหม่อีกครั้ง').css('color', '#e74c3c');
    }

   $(document).ready(function () {
    @if (!ViewData.ModelState.IsValid)
    {
        <text>
        Swal.fire({
            icon: 'warning',
            title: 'Login Fail',
            text: 'กรุณาตรวจสอบข้อมูลและยืนยัน reCAPTCHA อีกครั้ง',
            confirmButtonText: 'OK',
            confirmButtonColor: '#d33',
            allowOutsideClick: false
        });
        </text>
    }

    $('#Usre, #password-field').on('keyup change input paste', function () {
        if (recaptchaVerified) {
            setTimeout(tryAutoSubmit, 50);
        }
    });

    // ✅ ตัวจับหลัก: ดัก native browser autofill event ผ่าน CSS animation trick
       document.getElementById('Usre').addEventListener('animationstart', function (e) {
           console.log('Autofill detected:', e.animationName);
           console.log('recaptchaVerified:', recaptchaVerified);   // ✅ เพิ่มบรรทัดนี้
           console.log('Usre value at this moment:', $('#Usre').val());  // ✅ เพิ่มบรรทัดนี้

           if (e.animationName === 'onAutoFillStart') {
               // เพิ่ม delay จาก 50ms เป็น 200ms ให้ Chrome sync ค่าลง DOM ก่อน
               setTimeout(function () {
                   console.log('Usre value after delay:', $('#Usre').val());  // debug เพิ่ม
                   if (recaptchaVerified) {
                       tryAutoSubmit();
                   }
               }, 200);
           }
    });

    document.getElementById('password-field').addEventListener('animationstart', function (e) {
        if (e.animationName === 'onAutoFillStart') {
            setTimeout(function () {
                if (recaptchaVerified) {
                    tryAutoSubmit();
                }
            }, 200);
        }
    });

    $(document).on('click', function () {
        if (recaptchaVerified && !isAutoSubmitted) {
            setTimeout(tryAutoSubmit, 100);
        }
    });

    setTimeout(function () {
        var $usre = $('#Usre');
        var $pass = $('#password-field');

        // เก็บค่าเดิมไว้ก่อน เผื่อ focus/blur ไปกระทบ validation UI ที่ผูกกับ focus event อื่น
        $usre.trigger('focus').trigger('blur');
        $pass.trigger('focus').trigger('blur');

        console.log('After forced focus/blur - Usre:', $usre.val(), 'Pass:', $pass.val()); // debug ชั่วคราว
    }, 300);


});
    </script>
</body>
</html>